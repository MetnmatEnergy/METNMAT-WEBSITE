# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/
build/
dist/

# typescript incremental build cache (machine-specific, noisy)
*.tsbuildinfo

# env
# `.env` matches only that exact name and `.env*.local` only the .local
# variants, so .env.production and .env.development were NOT ignored — a real
# secrets file could be committed by an ordinary `git add .`. Keep .env.example
# tracked; it holds names, never values.
.env
.env.*
!.env.example
!.env*.example

# backups (may contain secrets)
*.bak

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# misc
.DS_Store
*.pem
.turbo
coverage/
next-env.d.ts

# local-dev CMS upload dirs (production stores files in GCS)
apps/dashboard/media/
apps/dashboard/enquiry-uploads/
apps/dashboard/blog-submission-files/
apps/dashboard/documents/

# staging area for scripts/attach-*.ts photo uploads — media never belongs in git
apps/dashboard/scripts/_img_tmp/
