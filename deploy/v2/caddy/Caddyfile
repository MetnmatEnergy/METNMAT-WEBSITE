# /etc/caddy/Caddyfile — the whole reverse-proxy config for the v2 host.
# Every public hostname terminates here and is proxied to a loopback port owned
# by a separate systemd unit and Linux user. Nothing else listens publicly.

{
	email dev@metnmat.com
	# Admin API stays on its default loopback-only socket so `systemctl reload caddy`
	# (zero-downtime config apply) works; nothing else can reach 127.0.0.1:2019.
	servers {
		# Trust nothing about client headers except what we set below.
		trusted_proxies static private_ranges
	}
}

(proxy_headers) {
	header_up X-Forwarded-Proto {scheme}
	header_up X-Forwarded-Host {host}
	header_up Host {host}
}

(site_log) {
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 20mb
			roll_keep 10
			roll_keep_for 720h
		}
	}
}

# ── Public website ─────────────────────────────────────────────────────────
# The apex→www 308 lives in the Next.js middleware (cookie-domain reasons); Caddy
# passes both names through untouched.
metnmat.com, www.metnmat.com {
	reverse_proxy 127.0.0.1:3100 {
		import proxy_headers
	}
	encode zstd gzip
	import site_log website
}

# ── Legacy domain: metnmat.in (the old Wix site) ──────────────────────────
# Every URL 301s, in one hop, to its www.metnmat.com equivalent. The map and the
# rules live in the website (apps/website/legacy-domain.mjs), so this block only
# delivers the request with its own Host header. It does nothing until
# metnmat.in's DNS points at this host — docs/seo/DOMAIN-CONSOLIDATION.md has the
# cutover order; until then Caddy just retries the certificate in the background.
metnmat.in, www.metnmat.in {
	reverse_proxy 127.0.0.1:3100 {
		import proxy_headers
	}
	import site_log legacy-in
}

# ── Payload CMS ────────────────────────────────────────────────────────────
admin.metnmat.com {
	reverse_proxy 127.0.0.1:3200 {
		import proxy_headers
	}
	# Datasheets and RFQ attachments stream through the CMS (private S3 bucket).
	request_body {
		max_size 50MB
	}
	encode zstd gzip
	import site_log cms
}

# ── Chatbot ────────────────────────────────────────────────────────────────
chat.metnmat.com {
	reverse_proxy 127.0.0.1:3002 {
		import proxy_headers
	}
	encode zstd gzip
	import site_log chat
}

# ── MTrace Command Center (internal staff tool) ────────────────────────────
command-center.metnmat.com {
	reverse_proxy 127.0.0.1:3000 {
		import proxy_headers
	}
	request_body {
		max_size 100MB
	}
	encode zstd gzip
	import site_log command-center
}
