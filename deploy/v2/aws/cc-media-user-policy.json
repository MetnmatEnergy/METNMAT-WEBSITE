{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CcMediaObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::metnmat-media-976134557584/*"
    },
    {
      "Sid": "CcMediaList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::metnmat-media-976134557584"
    }
  ]
}
