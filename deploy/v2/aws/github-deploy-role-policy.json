{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadArtifacts",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::metnmat-deploy-artifacts-976134557584/web/*",
        "arn:aws:s3:::metnmat-deploy-artifacts-976134557584/cms/*",
        "arn:aws:s3:::metnmat-deploy-artifacts-976134557584/chat/*",
        "arn:aws:s3:::metnmat-deploy-artifacts-976134557584/cc/*"
      ]
    },
    {
      "Sid": "RunReleaseOnTheProdHostOnly",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand"],
      "Resource": [
        "arn:aws:ec2:ap-south-1:976134557584:instance/${PROD_INSTANCE_ID}",
        "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadCommandResult",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations", "ssm:ListCommands"],
      "Resource": "*"
    }
  ]
}
