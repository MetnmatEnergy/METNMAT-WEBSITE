#!/usr/bin/env bash
# metnmat-fetch-secrets <app>
#
# Runs as ROOT from `ExecStartPre=+/usr/local/sbin/metnmat-fetch-secrets <app>`.
# Reads exactly ONE Secrets Manager entry — metnmat/<app>/env, a JSON object of
# KEY: value — merges it with the static, non-secret /etc/metnmat/<app>.conf,
# and writes /run/metnmat/<app>.env (root:root 0600) for systemd to load via
# EnvironmentFile=. The application process itself never has AWS credentials,
# never talks to Secrets Manager, and cannot read this file (the metadata
# service is blocked for non-root uids by nftables, and /run/metnmat is 0700).
#
# Fails CLOSED: any error, any missing required variable, any malformed value
# means the service does not start. Starting an app with half its secrets is
# how the old system ended up authenticating with placeholders.
#
# Logs variable NAMES only. Never values.
set -Eeuo pipefail

APP="${1:?usage: metnmat-fetch-secrets <web|cms|chat|cc>}"
case "$APP" in web|cms|chat|cc) ;; *) echo "[secrets] unknown app '$APP'" >&2; exit 64 ;; esac

# systemd applies the unit's EnvironmentFile to ExecStartPre as well, so on every
# restart after the first this process inherits whatever the PREVIOUS fetch wrote -
# including any AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY the app itself uses (the
# Command Center's bucket-only media key) and AWS_EC2_METADATA_DISABLED=true. The
# AWS CLI would then sign with the app's key instead of the instance role and be
# denied GetSecretValue. The fetcher must always speak as the instance role.
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE       AWS_SHARED_CREDENTIALS_FILE AWS_CONFIG_FILE AWS_EC2_METADATA_DISABLED AWS_ENDPOINT_URL
REGION="${AWS_REGION:-ap-south-1}"
SECRET_ID="metnmat/${APP}/env"
CONF="/etc/metnmat/${APP}.conf"
REQUIRED="/etc/metnmat/${APP}.required"
OUT_DIR="/run/metnmat"
OUT="${OUT_DIR}/${APP}.env"

log() { echo "[secrets:${APP}] $*" >&2; }

[ "$(id -u)" = "0" ] || { log "must run as root (ExecStartPre=+…)"; exit 77; }
umask 077
mkdir -p "$OUT_DIR"; chmod 0700 "$OUT_DIR"; chown root:root "$OUT_DIR"

# Static config is optional; required-list is optional; the secret is not.
[ -r "$CONF" ] || CONF=""
[ -r "$REQUIRED" ] || REQUIRED=""

json="$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "$SECRET_ID" \
        --query SecretString --output text 2>/tmp/metnmat-secrets-err.$$)" || {
  log "FATAL: cannot read ${SECRET_ID}: $(tr '\n' ' ' </tmp/metnmat-secrets-err.$$ | cut -c1-200)"
  rm -f /tmp/metnmat-secrets-err.$$; exit 78
}
rm -f /tmp/metnmat-secrets-err.$$

tmp="$(mktemp "${OUT_DIR}/.${APP}.env.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# Merge + validate + serialise in one pass. Values are written double-quoted in
# systemd EnvironmentFile syntax (backslash-escaped), so any printable value is
# safe; values containing newlines are rejected because systemd cannot represent
# them and a silently truncated secret is worse than a refused start.
MM_JSON="$json" MM_CONF="$CONF" MM_REQ="$REQUIRED" MM_OUT="$tmp" MM_APP="$APP" python3 - <<'PY'
import json, os, re, sys
app   = os.environ["MM_APP"]
KEY   = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")  # the chatbot uses mixed-case names (Meta_WA_accessToken)
BANNED = {"DIRECTOR_RESET", "SEED_PRUNE_PLACEHOLDERS"}   # boot-time data-deletion switches
env = {}

conf = os.environ["MM_CONF"]
if conf:
    for n, line in enumerate(open(conf, encoding="utf-8"), 1):
        line = line.strip()
        if not line or line.startswith("#"): continue
        k, _, v = line.partition("=")
        if not KEY.match(k): sys.exit(f"[secrets:{app}] {conf}:{n}: bad key {k!r}")
        env[k] = v

try:
    sec = json.loads(os.environ["MM_JSON"])
except Exception as e:
    sys.exit(f"[secrets:{app}] secret is not JSON ({e.__class__.__name__}); store it as key/value")
if not isinstance(sec, dict):
    sys.exit(f"[secrets:{app}] secret must be a JSON object of KEY: value")

placeholders = []
for k, v in sec.items():
    if not KEY.match(k): sys.exit(f"[secrets:{app}] refusing key {k!r} (must match ^[A-Za-z_][A-Za-z0-9_]*$)")
    if k in BANNED:
        print(f"[secrets:{app}] REFUSING {k} — never server config; run it as a one-off", file=sys.stderr); continue
    if v is None: continue
    if not isinstance(v, str): v = json.dumps(v) if isinstance(v, (dict, list)) else str(v)
    if v in ("", "SET_ME", "PLACEHOLDER_SET_ME", "CHANGE_ME"):
        placeholders.append(k); continue
    if "\n" in v or "\r" in v: sys.exit(f"[secrets:{app}] value of {k} contains a newline")
    env[k] = v                      # secret wins over static config

req = os.environ["MM_REQ"]
if req:
    # Line-based: a "#" line is a comment in full (word-splitting the whole file
    # turned every comment word into a "required key" and refused every start).
    need = [w for line in open(req, encoding="utf-8") if not line.strip().startswith("#") for w in line.split()]
    missing = [k for k in need if not env.get(k)]
    if missing: sys.exit(f"[secrets:{app}] FATAL: required variable(s) missing or placeholder: {' '.join(missing)}")

def q(v):  # systemd EnvironmentFile double-quoted value
    return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'
with open(os.environ["MM_OUT"], "w", encoding="utf-8") as f:
    for k in sorted(env): f.write(f"{k}={q(env[k])}\n")

print(f"[secrets:{app}] wrote {len(env)} variable(s): {' '.join(sorted(env))}", file=sys.stderr)
if placeholders:
    print(f"[secrets:{app}] not set (placeholder), NOT exported: {' '.join(sorted(placeholders))}", file=sys.stderr)
PY

chown root:root "$tmp"; chmod 0600 "$tmp"
mv -f "$tmp" "$OUT"
trap - EXIT
log "ready: $OUT"
