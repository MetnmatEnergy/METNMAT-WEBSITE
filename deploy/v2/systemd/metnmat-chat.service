[Unit]
Description=METNMAT customer-agent chatbot (Bun) on 127.0.0.1:3002
Documentation=file:///srv/metnmat/README-v2.md
After=network-online.target nftables.service
Wants=network-online.target
Requires=nftables.service

[Service]
Type=simple
User=mm-chat
Group=mm-chat
WorkingDirectory=/srv/metnmat/chat/current

ExecStartPre=+/usr/local/sbin/metnmat-fetch-secrets chat
EnvironmentFile=/run/metnmat/chat.env
ExecStart=/usr/local/bin/bun run index.ts

Restart=always
RestartSec=4
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metnmat-chat

MemoryHigh=800M
MemoryMax=1000M
TasksMax=512

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/metnmat/chat/releases
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
IPAddressDeny=193.32.162.134/32 45.86.86.23/32

[Install]
WantedBy=multi-user.target
