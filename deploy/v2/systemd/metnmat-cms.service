[Unit]
Description=METNMAT Payload CMS (Next.js) on 127.0.0.1:3200
Documentation=file:///srv/metnmat/README-v2.md
After=network-online.target nftables.service
Wants=network-online.target
Requires=nftables.service

[Service]
Type=simple
User=mm-cms
Group=mm-cms
WorkingDirectory=/srv/metnmat/cms/current

# Root fetches ONLY metnmat/cms/env. That secret also carries the CMS's own
# S3 access key (IAM user metnmat-cms-media, media bucket only) because the
# metadata service is blocked for this uid — the CMS cannot use the host role.
ExecStartPre=+/usr/local/sbin/metnmat-fetch-secrets cms
EnvironmentFile=-/run/metnmat/cms.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3200 --hostname 127.0.0.1

Restart=always
RestartSec=4
TimeoutStopSec=45
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metnmat-cms

# sharp allocates outside the V8 heap, so the cgroup cap (not the heap flag) is
# what bounds an upload spike. Heap 1536 MB, unit 2.6 GB.
MemoryHigh=2200M
MemoryMax=2600M
TasksMax=1024

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/metnmat/cms/releases
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
IPAddressDeny=193.32.162.134/32 45.86.86.23/32

[Install]
WantedBy=multi-user.target
