# syntax=docker/dockerfile:1
# ── METNMAT dashboard (Payload CMS on Next.js 15) → Google Cloud Run ─────────
# Payload has no standalone output, so the runtime ships node_modules + .next.
# Build CONTEXT must be the monorepo ROOT.

FROM node:22-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# Toolchain for native deps (sharp image processing).
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.5.1

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/website/package.json   apps/website/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages/types/package.json packages/types/package.json
RUN pnpm install --frozen-lockfile --filter dashboard...

COPY packages/types  packages/types
COPY apps/dashboard  apps/dashboard

# A stale generated payload-types.ts breaks the loose-typed seed. The committed
# src/app/(payload)/admin/importMap.js is hand-maintained — do NOT regenerate it.
RUN rm -f apps/dashboard/src/payload-types.ts
RUN pnpm --filter dashboard build

# Drop the build cache before it reaches the runtime stage.
#
# Measured on a real build of this workspace:
#     .next/cache/webpack   982 MiB     <- pure build accelerator (local figure)
#     .next/cache/eslint     44 KB
#     .next/cache/swc         0 B
#     .next  (everything else)  14 MB   <- what `next start` actually serves
#
# 98.7% of .next is a webpack cache that `next start` never opens, and the
# runtime stage below copies /app wholesale — so every build was shipping it to
# Artifact Registry and pulling it on every cold start. turbo.json already
# declares "!.next/cache/**" a non-output, so nothing downstream expects it.
#
# The 982 MiB above is a LOCAL measurement and overstates the container saving.
# Broken down: server-production 652, client-production 191, edge-server 1 —
# but client-development 86 and server-development 54 only exist because
# `next dev` has run on this machine. A container only ever runs `next build`,
# so the real saving there is the production entries: ~844 MiB.
#
# There is no .next/cache/fetch-cache or /images here, so no RUNTIME cache is
# being discarded — only build scratch. Next recreates those directories itself
# if a request ever needs them.
# Delete the big build caches BY NAME rather than the whole directory.
#
# `.next/cache` also holds `.rscinfo`, which caches the Server Actions
# encryption key. Next generates that key at build time and embeds it in the
# build output; `.rscinfo` is what lets a REBUILD reuse the same key. Payload's
# admin is built on Server Actions (apps/dashboard/src/app/(payload)/layout.tsx
# is "use server"), and a key that changes between revisions means an in-flight
# action bound by the old revision can fail to decrypt on the new one during a
# rollout.
#
# Today that is already happening and is NOT caused by this line: there is no
# --cache-from or kaniko anywhere, so every Cloud Build run starts cold and
# `.rscinfo` never survived between builds anyway. But deleting it wholesale
# would silently defeat the fix if layer caching is ever added — which is on the
# optimisation roadmap — so keep it.
#
# The real fix is to set NEXT_SERVER_ACTIONS_ENCRYPTION_KEY from Secret Manager
# so the key is stable across builds AND across instances. Tracked separately;
# it needs a secret created, which this service account cannot do.
RUN rm -rf apps/dashboard/.next/cache/webpack \
           apps/dashboard/.next/cache/eslint \
           apps/dashboard/.next/cache/swc \
           apps/dashboard/.next/cache/.tsbuildinfo

# Reinstall production-only, now the build no longer needs devDependencies.
#
# DO NOT replace this with `pnpm prune --prod`. That exits 1 in a Dockerfile RUN
# (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY) — and "fixing" that with CI=true
# or --config.confirmModulesPurge=false is worse: it exits 0, prints "Already up
# to date", and leaves apps/dashboard/node_modules an EMPTY DIRECTORY, with
# payload, next, sharp and @payloadcms/next all MODULE_NOT_FOUND. A green build
# producing a container that cannot boot beats a red build only in appearance.
# Both behaviours were reproduced against a staged copy of this workspace.
#
# A full reinstall is used instead of a prune because it is lockfile-driven and
# therefore deterministic: measured exit 0 in 24.6s with 0 downloads, reporting
# "Lockfile is up to date, resolution step is skipped". It runs AFTER
# `pnpm --filter dashboard build` on purpose — next build runs the lint pass and
# needs eslint present.
#
# The assertions are the whole safety story. Without a Docker daemon here this
# change cannot be tested before it ships, so the guards convert the failure
# mode from "silently broken image on a mutable :latest tag" into "red build".
# Note `require.resolve('payload')` resolves but `require.resolve(
# 'payload/package.json')` does NOT — payload does not export that subpath, and
# using it as a guard fails on a perfectly healthy tree.
RUN rm -rf node_modules apps/dashboard/node_modules \
 && pnpm install --frozen-lockfile --filter dashboard... --prod \
 && test -e apps/dashboard/node_modules/next/package.json \
 && test -e apps/dashboard/node_modules/payload/package.json \
 && test -e apps/dashboard/node_modules/sharp/package.json \
 && test -e apps/dashboard/node_modules/@payloadcms/next \
 && node -e "require.resolve('payload',{paths:['/app/apps/dashboard']})" \
 && node -e "require.resolve('next',{paths:['/app/apps/dashboard']})" \
 && test -d apps/dashboard/.next/server \
 && test -f apps/dashboard/.next/BUILD_ID
#
# WHAT IT IS ACTUALLY WORTH — and this corrects an earlier note here that said
# ~33 MB with typescript as the big line. That was WRONG:
#
#   * Measured 707.4 MB -> 594.5 MB = 112.9 MB (16%, 8,702 files).
#   * `typescript` (23 MB) is NOT recovered. It is in payload's PRODUCTION
#     graph: @payloadcms/richtext-lexical -> ts-essentials -> typescript
#     (optional peer, pnpm-lock.yaml:8559). Same story for @types/node (via
#     payload -> @types/busboy) and @types/react (via @payloadcms/ui ->
#     react-select -> @emotion/react). Only @types/react-dom is dashboard-only.
#   * ~73 MB of the 113 MB is the workspace ROOT's devDeps (turbo, rolldown,
#     lightningcss platform binaries), which `--filter dashboard...` pulls in.
#   * The single biggest item in the image, @next/swc-* at 176.9 MB, is an
#     optionalDependency of `next` and survives --prod untouched — even though
#     `next start` provably never loads it. Pruning cannot reach it.
#
# STILL TRUE: nothing in the built server output requires a devDependency at
# runtime. All 17 external require() specifiers in .next/server were resolved
# against both a full and a real prod-only install: zero regressions.
# payload.config.ts is webpack-compiled into .next/server/chunks/4894.js, and
# Payload's generate:types / generateImportMap are both gated on
# NODE_ENV !== 'production', so a prod container can never regenerate
# importMap.js (CLAUDE.md gotcha #2 belongs to `next dev`, not to this image).

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@11.5.1

# Bring the whole built workspace (node_modules + .next + config + source that
# `next start` reads at runtime). Larger image, but reliable for Payload — and
# the build cache has already been removed above, which is the bulk of it.
#
# This stays a single COPY on purpose. pnpm links every package from
# node_modules/.pnpm via symlinks, so splitting it into selective COPYs risks
# breaking module resolution at RUNTIME rather than at build time — the worst
# possible place to find out, given the deployed tag is mutable.
COPY --from=builder /app ./

WORKDIR /app/apps/dashboard
EXPOSE 8080
# The start script hardcodes -p 3001; override to honour Cloud Run's $PORT (8080).
# --keepAliveTimeout MUST exceed the ALB's idle_timeout (300s). Node closes idle
# keep-alive sockets after 5s by default; when the load balancer still considers
# a pooled connection usable, it reuses one the origin has just closed and
# answers 502. Intermittent and traffic-dependent, so it will not show up in
# testing. `next start` ignores the KEEP_ALIVE_TIMEOUT env var that the website's
# standalone server reads, so it has to come in as a flag here.
CMD ["sh", "-c", "pnpm exec next start -p ${PORT:-8080} --keepAliveTimeout ${KEEP_ALIVE_TIMEOUT:-310000}"]
