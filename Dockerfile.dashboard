# syntax=docker/dockerfile:1
# ── METNMAT dashboard (Payload CMS on Next.js 15) → Google Cloud Run ─────────
# Payload has no standalone output, so the runtime ships node_modules + .next.
# Build CONTEXT must be the monorepo ROOT.

FROM node:22-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# Toolchain for native deps (sharp image processing).
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.5.1

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/website/package.json   apps/website/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages/types/package.json packages/types/package.json
RUN pnpm install --frozen-lockfile --filter dashboard...

COPY packages/types  packages/types
COPY apps/dashboard  apps/dashboard

# A stale generated payload-types.ts breaks the loose-typed seed. The committed
# src/app/(payload)/admin/importMap.js is hand-maintained — do NOT regenerate it.
RUN rm -f apps/dashboard/src/payload-types.ts
RUN pnpm --filter dashboard build

# Drop the build cache before it reaches the runtime stage.
#
# Measured on a real build of this workspace:
#     .next/cache/webpack   982 MiB     <- pure build accelerator (local figure)
#     .next/cache/eslint     44 KB
#     .next/cache/swc         0 B
#     .next  (everything else)  14 MB   <- what `next start` actually serves
#
# 98.7% of .next is a webpack cache that `next start` never opens, and the
# runtime stage below copies /app wholesale — so every build was shipping it to
# Artifact Registry and pulling it on every cold start. turbo.json already
# declares "!.next/cache/**" a non-output, so nothing downstream expects it.
#
# The 982 MiB above is a LOCAL measurement and overstates the container saving.
# Broken down: server-production 652, client-production 191, edge-server 1 —
# but client-development 86 and server-development 54 only exist because
# `next dev` has run on this machine. A container only ever runs `next build`,
# so the real saving there is the production entries: ~844 MiB.
#
# There is no .next/cache/fetch-cache or /images here, so no RUNTIME cache is
# being discarded — only build scratch. Next recreates those directories itself
# if a request ever needs them.
# Delete the big build caches BY NAME rather than the whole directory.
#
# `.next/cache` also holds `.rscinfo`, which caches the Server Actions
# encryption key. Next generates that key at build time and embeds it in the
# build output; `.rscinfo` is what lets a REBUILD reuse the same key. Payload's
# admin is built on Server Actions (apps/dashboard/src/app/(payload)/layout.tsx
# is "use server"), and a key that changes between revisions means an in-flight
# action bound by the old revision can fail to decrypt on the new one during a
# rollout.
#
# Today that is already happening and is NOT caused by this line: there is no
# --cache-from or kaniko anywhere, so every Cloud Build run starts cold and
# `.rscinfo` never survived between builds anyway. But deleting it wholesale
# would silently defeat the fix if layer caching is ever added — which is on the
# optimisation roadmap — so keep it.
#
# The real fix is to set NEXT_SERVER_ACTIONS_ENCRYPTION_KEY from Secret Manager
# so the key is stable across builds AND across instances. Tracked separately;
# it needs a secret created, which this service account cannot do.
RUN rm -rf apps/dashboard/.next/cache/webpack \
           apps/dashboard/.next/cache/eslint \
           apps/dashboard/.next/cache/swc \
           apps/dashboard/.next/cache/.tsbuildinfo

# NOTE — devDependency pruning was attempted here and REVERTED (commit 0d1585b).
#
# `pnpm prune --prod` failed the Docker build outright (build step 0, exit 1),
# so the dashboard could not deploy at all until this was taken back out. The
# build-log detail is not readable from the deploy service account
# (`gcloud builds log` -> PERMISSION_DENIED), so the exact cause is not yet
# established — the leading suspect is that `pnpm prune` does not operate
# cleanly on a tree installed with `--filter dashboard...`, which is a PARTIAL
# workspace install rather than a full one.
#
# Do not re-attempt this without a way to run the build locally. The prize is
# small and was over-stated in the original audit: ~33 MB uncompressed
# (typescript 23, eslint 4, eslint-config-next 1, @types/* 5) — roughly 3% of
# the ~844 MiB of webpack cache already removed above. @next/swc is NOT part of
# it; that arrives via `next`, which is a production dependency.
#
# Verified separately and still true, for whoever picks this up: nothing in the
# built server output requires any devDependency at runtime — 0 occurrences of
# require("typescript" | "eslint" | "@types/*"). So the idea is sound; only the
# mechanism failed.

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@11.5.1

# Bring the whole built workspace (node_modules + .next + config + source that
# `next start` reads at runtime). Larger image, but reliable for Payload — and
# the build cache has already been removed above, which is the bulk of it.
#
# This stays a single COPY on purpose. pnpm links every package from
# node_modules/.pnpm via symlinks, so splitting it into selective COPYs risks
# breaking module resolution at RUNTIME rather than at build time — the worst
# possible place to find out, given the deployed tag is mutable.
COPY --from=builder /app ./

WORKDIR /app/apps/dashboard
EXPOSE 8080
# The start script hardcodes -p 3001; override to honour Cloud Run's $PORT (8080).
CMD ["sh", "-c", "pnpm exec next start -p ${PORT:-8080}"]
