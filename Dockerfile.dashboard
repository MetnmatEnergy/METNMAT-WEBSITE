# syntax=docker/dockerfile:1
# ── METNMAT dashboard (Payload CMS on Next.js 15) → Google Cloud Run ─────────
# Payload has no standalone output, so the runtime ships node_modules + .next.
# Build CONTEXT must be the monorepo ROOT.

FROM node:22-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# Toolchain for native deps (sharp image processing).
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.5.1

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/website/package.json   apps/website/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages/types/package.json packages/types/package.json
RUN pnpm install --frozen-lockfile --filter dashboard...

COPY packages/types  packages/types
COPY apps/dashboard  apps/dashboard

# A stale generated payload-types.ts breaks the loose-typed seed. The committed
# src/app/(payload)/admin/importMap.js is hand-maintained — do NOT regenerate it.
RUN rm -f apps/dashboard/src/payload-types.ts
RUN pnpm --filter dashboard build

# Drop the build cache before it reaches the runtime stage.
#
# Measured on a real build of this workspace:
#     .next/cache/webpack   982 MB      <- pure build accelerator
#     .next/cache/eslint     44 KB
#     .next/cache/swc         0 B
#     .next  (everything else)  14 MB   <- what `next start` actually serves
#
# 98.7% of .next is a webpack cache that `next start` never opens, and the
# runtime stage below copies /app wholesale — so every build was shipping it to
# Artifact Registry and pulling it on every cold start. turbo.json already
# declares "!.next/cache/**" a non-output, so nothing downstream expects it.
#
# There is no .next/cache/fetch-cache or /images here, so no RUNTIME cache is
# being discarded — only build scratch. Next recreates those directories itself
# if a request ever needs them.
RUN rm -rf apps/dashboard/.next/cache

# Drop devDependencies now the build is done. Verified against the BUILT server
# output before doing this — there is not a single runtime require of any of
# them:
#
#     require("typescript")  0    require("eslint")            0
#     require("@types/node") 0    require("eslint-config-next") 0
#
# Every "typescript" string in .next/server is a syntax-highlighting language
# list, a Payload config FIELD named `typescript`, or Monaco's own bundled TS
# services — never the npm package. The Payload config is compiled into the
# server bundle at build time (collection slugs appear inlined), so nothing
# loads payload.config.ts at runtime either.
#
# Worth being clear about the size of this prize: ~33 MB uncompressed
# (typescript 23, eslint 4, eslint-config-next 1, @types/* 5). It is NOT the
# hundreds of MB an earlier reading suggested — @next/swc is pulled in by
# `next`, which is a PRODUCTION dependency, so it ships either way.
#
# The `node -e require.resolve` is the guard that makes this safe to ship
# without a local Docker daemon: if pruning breaks pnpm's symlink tree, the
# BUILD fails here rather than the container failing to boot in production.
# The guards check pnpm's SYMLINKS survived, which is the actual failure mode —
# a broken link surfaces at runtime, not build time. `require.resolve` on the
# package root is deliberately avoided: payload does not export ./package.json,
# so that check fails even on a perfectly healthy tree.
RUN pnpm prune --prod \
 && test -e apps/dashboard/node_modules/next \
 && test -e apps/dashboard/node_modules/payload \
 && test -e apps/dashboard/node_modules/@payloadcms \
 && test -e apps/dashboard/node_modules/sharp \
 && node -e "require.resolve('next/package.json',{paths:['./apps/dashboard']})" \
 && test -d apps/dashboard/.next/server \
 && test -f apps/dashboard/.next/BUILD_ID

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@11.5.1

# Bring the whole built workspace (node_modules + .next + config + source that
# `next start` reads at runtime). Larger image, but reliable for Payload — and
# the build cache has already been removed above, which is the bulk of it.
#
# This stays a single COPY on purpose. pnpm links every package from
# node_modules/.pnpm via symlinks, so splitting it into selective COPYs risks
# breaking module resolution at RUNTIME rather than at build time — the worst
# possible place to find out, given the deployed tag is mutable.
COPY --from=builder /app ./

WORKDIR /app/apps/dashboard
EXPOSE 8080
# The start script hardcodes -p 3001; override to honour Cloud Run's $PORT (8080).
CMD ["sh", "-c", "pnpm exec next start -p ${PORT:-8080}"]
